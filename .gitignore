# =========================================================
# IntelliRide - Root Git Ignore
# =========================================================

# Environment / Secrets
.env
.env.*
!.env.example

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editor
.vscode/
.idea/

# Logs
*.log

# Python cache (for AI/FastAPI services, if any)
__pycache__/
*.py[cod]

# Python virtual environments
.venv/
venv/
env/

# Temporary files
*.tmp
*.temp

# IntelliRide internal development documentation
/docs/
/DEVELOPMENT_PROGRESS.md

FRONTEND_UI_REDESIGN_GUIDE.md
QA_RESULTS.md
REDESIGN_FILE_CHANGES.md